# ==============================================================================
# PÁGINASOLO (SaaS Multitenant de Landing Pages Locais) — Variáveis de Ambiente
# ==============================================================================

# Domínio raiz usado pelo middleware para roteamento por subdomínio
NEXT_PUBLIC_ROOT_DOMAIN=paginasolo.com.br

# Credenciais do Supabase (Auth, PostgreSQL c/ RLS e Storage)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# ------------------------------------------------------------------------------
# URL pública do app (usada em sitemap, canonical e retorno do Mercado Pago).
# Em produção: https://paginasolo.com.br  | Em dev: http://localhost:3004
# O Mercado Pago exige URL https pública para o back_url/webhook (use ngrok em dev).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Mercado Pago (Assinaturas / preapproval). Access Token de PRODUÇÃO da conta que recebe.
MP_ACCESS_TOKEN=
# Preço mensal em reais
PLAN_PRICE_BRL=37

# Claude API: escreve headline/descrição/serviços. Opcional (sem chave usa template).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
